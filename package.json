{
  "name": "gpa-tracker",
  "version": "2.0.0",
  "private": true,
  "description": "純前端、離線可用的香港 VTC/IVE GPA 成績追蹤與試算工具，可直接部署至 Cloudflare Pages。",
  "type": "commonjs",
  "scripts": {
    "serve": "npx --yes serve public",
    "test": "node scripts/build-rule-validator.cjs --check && node --test tests/*.test.js",
    "build:rules": "node scripts/build-rule-validator.cjs",
    "test:db": "node scripts/test-supabase-safety.cjs",
    "test:db:concurrency": "node scripts/test-supabase-safety.cjs --concurrency",
    "test:db:cleanup": "node scripts/test-supabase-safety.cjs --cleanup"
  },
  "keywords": [
    "gpa",
    "vtc",
    "ive",
    "cloudflare-pages",
    "localstorage",
    "vanilla-js",
    "gpa-calculator"
  ],
  "license": "MIT",
  "devDependencies": {
    "ajv": "8.17.1",
    "pg": "8.16.3"
  }
}
